# ---------- Servidor ----------
PORT=3000
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ---------- Base de datos ----------
DATABASE_URL=postgres://bpg:bpg@localhost:5432/bpg
# true si tu proveedor exige SSL (Neon, RDS, Render, Supabase, etc.)
DATABASE_SSL=false

# ---------- Autenticación ----------
# Cambia este valor por una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=12h

# Administrador inicial: se crea solo si no existe ningún usuario
ADMIN_EMAIL=admin@bpg.local
ADMIN_PASSWORD=Admin12345
ADMIN_NOMBRE=Administrador

# ---------- Almacenamiento de evidencias ----------
# local: guarda los archivos en disco (desarrollo / demo)
# s3: guarda en Amazon S3 (o compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# URL pública de la API, para armar los enlaces de los archivos locales.
# Déjala vacía si el frontend llama a la API por el mismo dominio (/api).
PUBLIC_API_URL=

# Solo si STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
# Opcional: credenciales explícitas (si no, se usa el rol IAM / variables AWS_*)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional: servicios compatibles con S3 (MinIO, Cloudflare R2, etc.)
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
